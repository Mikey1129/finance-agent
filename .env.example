# 复制本文件为 .env 并填入真实值（.env 已在 .gitignore，不会入库）
# 说明见 README「配置（环境变量）」

# DeepSeek 推理模型（LLM 决策层 + 归因结论合成）
DEEPSEEK_API_KEY=sk-...

# DashScope reranker（qwen3-rerank，生产默认关闭，ENABLE_RERANKER=1 才启用）
DASHSCOPE_API_KEY=sk-...

# DashScope 视觉兜底（Qwen3-VL 扫描件解析，可选）
DASHSCOPE_VL_API_KEY=sk-...

# 可选覆盖（缺省用 config/settings.py 的默认值）
# LLM_MODEL=deepseek-v4-pro
# LLM_BASE_URL=https://api.deepseek.com/v1
# ENABLE_RERANKER=false
